APP_NAME=wob
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wob
DB_USERNAME=wob
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SAME_SITE=lax

# The SPA and the API must be same-site for the session cookie to travel.
# In development the Vite proxy in docs/frontend.md arranges that.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SESSION_DOMAIN=localhost

CACHE_STORE=database

# Google Cloud console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorised JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# The Node service that replays runs to check their times.
# Empty means times are stored but never verified, and the board says so.
WOB_VERIFIER_URL=http://127.0.0.1:8090/verify

# Вход без Google для локальной разработки (см. AuthController::dev).
# Работает только при APP_ENV=local.
WOB_DEV_LOGIN=false

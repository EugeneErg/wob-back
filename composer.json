{
    "name": "wob/backend",
    "description": "Backend for WOB — cloud library, Google sign-in, player progress.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "7.1",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "13.29",
        "laravel/sanctum": "^4.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Wob\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wob\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "stan:domain": "phpstan analyse src/Shared src/Library/Domain src/Library/Application src/Identity/Domain src/Identity/Application src/Progress/Domain src/Progress/Application --level=8 --no-progress",
        "check": [
            "@stan",
            "@stan:domain",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
